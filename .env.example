# Copy this file to .env and adjust values for local development.
# On Render, set these as environment variables in the dashboard instead.

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
RESEND_API_KEY=re_123456789_your_resend_api_key_here
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# DATABASE_URL is only needed on Render (PostgreSQL).
# Leave it unset locally to use SQLite.
